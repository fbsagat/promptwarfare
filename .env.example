# Ferramentas offline (tools/): chave do Gemini para gerar candidatos ao catálogo.
# O servidor do jogo NÃO usa esta chave e sobe sem ela.
# GEMINI_API_KEY=

# Porta HTTP/WebSocket do servidor (padrão: 3000).
# Vale para `npm run dev`/`npm start`; o container sempre escuta 3000 internamente
# e publica no host a porta definida em API_PORT (abaixo).
PORT=3000

# Portas do ambiente local (api-docker.bat / api-local.bat / frontend.bat).
# API_PORT = porta da API: o docker-compose.yml publica no host; o api-local.bat usa como PORT (padrão local 3100).
# FRONTEND_PORT = porta do Vite; também entra no CORS do api-local e do container.
# API_PORT=3000
# FRONTEND_PORT=5173

# Interface de escuta. Use 127.0.0.1 quando houver um proxy reverso na VPS.
HOST=0.0.0.0

# Use "production" para servir o build estático de dist/ em vez do middleware Vite.
NODE_ENV=development

# "false" desabilita a entrega do cliente pelo servidor (API-only na VPS).
SERVE_CLIENT=true

# Caminho do ledger append-only de prompts (runtime).
# PROMPT_LEDGER_DB_PATH=./data/prompt-ledger.db

# Backend do ledger: "sqlite" (padrão) ou "postgres" (múltiplas instâncias).
# O backend postgres exige PROMPT_LEDGER_POSTGRES_URL e o pacote "pg" instalado.
# PROMPT_LEDGER_BACKEND=sqlite
# PROMPT_LEDGER_POSTGRES_URL=postgres://user:pass@host:5432/promptwarfare

# Nome da rede Docker externa da stack de monitoramento (docker-compose.prod.yml).
# MONITORING_NETWORK=memetrigger_default

# Origem pública dos assets relativos do manifesto (MinIO/S3/CDN).
# ASSET_BASE_URL=https://cdn.promptwarfare.com/assets

# Caminho opcional do cache SQLite da ferramenta offline de IA.
# VOXELFORGE_DB_PATH=./data/voxelforge-blueprints.db

# Desativa HMR e file watching do Vite quando "true" (útil em ambientes automatizados).
# DISABLE_HMR=false

# Origens permitidas para CORS e para o handshake WebSocket, separadas por vírgula.
# Aceita curingas, por exemplo https://prompt-warfare-*.vercel.app.
# Vazio = HTTP somente mesma origem e WebSocket sem checagem de origem.
# CORS_ORIGINS=https://prompt-warfare.vercel.app
# Exemplo local com frontend separado: CORS_ORIGINS=http://localhost:5173

# Hot reload do catálogo em runtime (padrão: ligado). "false" exige restart.
# CATALOG_WATCH=true

# Janela de agregação do snapshot exposto em /api/metrics (dias).
# METRICS_WINDOW_DAYS=90

# Token opcional para /api/metrics via header X-Metrics-Token.
# Sem token, o endpoint responde agregados públicos.
# METRICS_TOKEN=

# URL pública da API na VPS. Lida pelo Vite em tempo de build (Vercel).
# Vazio = mesma origem (desenvolvimento local).
# VITE_API_URL=https://api.promptwarfare.com

# URL completa do WebSocket. Se vazio, é derivada de VITE_API_URL.
# VITE_WS_URL=wss://api.promptwarfare.com/ws
