{
  "name": "prompt-warfare",
  "private": true,
  "version": "0.1.0",
  "description": "Arena battle royale 3D em micro-voxels destrutíveis, com armas e eventos de mapa resolvidos por um catálogo versionado.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "catalog:build": "tsx tools/build-catalog.ts",
    "catalog:candidates": "tsx tools/catalog-candidates.ts",
    "catalog:promote": "tsx tools/promote-candidates.ts",
    "demand:seed": "tsx tools/seed-demand.ts",
    "ledger:report": "tsx tools/ledger-report.ts",
    "loop:report": "tsx tools/loop-report.ts",
    "ledger:prune": "tsx tools/ledger-prune.ts",
    "usage:report": "tsx tools/usage-report.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@babylonjs/core": "^9.36.0",
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
